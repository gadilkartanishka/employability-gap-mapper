# --- Project Settings ---
PROJECT_NAME="Employability Gap Mapper"
SECRET_KEY="generate_a_strong_secret_key_here"

# --- Database ---
# For local dev, SQLite is used by default if this is empty
# DATABASE_URL="postgresql://user:pass@localhost:5432/dbname"

# --- Storage ---
UPLOAD_DIR="uploads"

# --- Redis / Celery ---
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
# For local testing without Redis set this to True
CELERY_TASK_ALWAYS_EAGER=True

# --- NLP Scraper ---
# Get your key from https://serpapi.com/
SERPAPI_KEY="your_api_key_here"
